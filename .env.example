# Copy to .env (scripts/dev-env.sh init does this and generates the secrets).
# .env is git-ignored. Never commit real values.

# PostgreSQL (docker compose, bound to 127.0.0.1 only)
IOETI_DB_HOST=127.0.0.1
IOETI_DB_PORT=5433
IOETI_DB_NAME=ioeti_dev
IOETI_DB_USER=ioeti_dev
IOETI_DB_PASSWORD=change-me

# Axelor application
IOETI_APP_PORT=8080
# Used by Axelor to encrypt sensitive columns (encryption.password). Generated per developer.
IOETI_ENCRYPTION_PASSWORD=change-me
IOETI_BANKORDER_ENCRYPTION_PASSWORD=change-me
# Files/attachments directory (relative to the repository root or absolute)
IOETI_DATA_DIR=.local/data
# Default UI locale for new sessions: en or ar
IOETI_LOCALE=en
