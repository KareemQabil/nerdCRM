<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.2.xsd">

  <module name="ioeti" package="com.ioeti.automation.db"/>

  <!-- Wave 7b: in-app notices and the held outbox. Explicit ioeti_ table names keep every object under
       the migration gate (G-008). -->

  <!-- One notice in one user's inbox. It links to a record; opening it applies the reader's own rights. -->
  <entity name="InboxNotice" table="ioeti_auto_notification">
    <many-to-one name="recipient" ref="com.axelor.auth.db.User" title="For" required="true"/>
    <many-to-one name="actor" ref="com.axelor.auth.db.User" title="From"/>
    <string name="kind" title="Kind" required="true" max="60"/>
    <string name="subject" title="Record type" max="40"/>
    <long name="subjectId" title="Record"/>
    <string name="title" title="Text" required="true" max="300"/>
    <boolean name="seen" title="Read"/>
    <datetime name="createdAt" title="At" required="true"/>
  </entity>

  <!-- A message to a lead, drafted and checked against consent. Sending is blocked (D-10). -->
  <entity name="OutboundMessage" table="ioeti_auto_outbound">
    <many-to-one name="lead" ref="com.axelor.apps.crm.db.Lead" title="Lead" required="true"/>
    <integer name="channelSelect" title="Channel" required="true"/>
    <string name="subjectLine" title="Subject line" required="true" max="200"/>
    <string name="body" title="Text" large="true"/>
    <integer name="statusSelect" title="Status" required="true"/>
    <many-to-one name="author" ref="com.axelor.auth.db.User" title="Drafted by"/>
    <datetime name="createdAt" title="Drafted at" required="true"/>

    <extra-code><![CDATA[
      public static final int CHANNEL_EMAIL = 1;
      public static final int STATUS_DRAFT = 1;
      public static final int STATUS_CANCELLED = 2;
    ]]></extra-code>
  </entity>

</domain-models>
