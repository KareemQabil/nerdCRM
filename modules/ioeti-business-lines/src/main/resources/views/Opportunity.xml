<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <!-- Adds the IOETI business line next to the native opportunity type. Upstream view untouched. -->
  <form id="ioeti-opportunity-form" name="opportunity-form" title="Opportunity"
    model="com.axelor.apps.crm.db.Opportunity" extension="true">
    <extend target="//field[@name='opportunityType']">
      <insert position="after">
        <field name="ioetiBusinessLine" colSpan="4" canNew="false" canEdit="false"
          domain="self.statusSelect = 2"/>
      </insert>
    </extend>
  </form>

</object-views>
