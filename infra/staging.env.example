# Internal staging ONLY; copy to /etc/ioeti/staging.env (0600) and replace placeholders.
IOETI_ENV=staging
IOETI_STAGING_ORIGIN=https://crm.example.org
VITE_IOETI_DEMO=false
IOETI_DB_HOST=127.0.0.1
IOETI_DB_PORT=5432
IOETI_DB_NAME=ioeti_stage
IOETI_DB_USER=ioeti_stage
IOETI_DB_PASSWORD=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
IOETI_LOCALE=ar
IOETI_ENCRYPTION_PASSWORD=REPLACE_WITH_DIFFERENT_32_PLUS_CHAR_SECRET
IOETI_BANKORDER_ENCRYPTION_PASSWORD=REPLACE_WITH_THIRD_UNIQUE_32_PLUS_CHAR_SECRET
IOETI_DATA_DIR=/var/lib/ioeti/data
IOETI_LOG_DIR=/var/log/ioeti
IOETI_APP_PORT=8080
