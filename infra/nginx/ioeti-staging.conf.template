# Replace __HOST__, __CERT_FILE__, __KEY_FILE__, __WEB_DIST__ and verify with nginx -t.
# Install in nginx's HTTP context (e.g. conf.d), NOT nested inside an existing server block.
map $http_upgrade $ioeti_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name __HOST__;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name __HOST__;
    ssl_certificate __CERT_FILE__;
    ssl_certificate_key __KEY_FILE__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root __WEB_DIST__;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location = /axelor-erp { return 308 /axelor-erp/; }
    location ^~ /axelor-erp/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace instead of appending untrusted client X-Forwarded-For.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ioeti_connection_upgrade;
        proxy_read_timeout 120s;
        proxy_connect_timeout 5s;
        proxy_cache off;
        client_max_body_size 20m;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-store" always;
    }
    location ~ /\. { deny all; }
}
